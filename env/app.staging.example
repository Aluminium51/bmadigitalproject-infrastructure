# Copy to env/app.staging on the Application VM.
# Never commit the real file.

# Use a release or sha tag for review. Pin both values to the published
# immutable digest before staging deployment:
# ghcr.io/ORG/bma-backend:v1.2.3
# ghcr.io/ORG/bma-backend:sha-<40-character-git-sha>
# ghcr.io/ORG/bma-backend@sha256:<digest>
BACKEND_IMAGE_REF=ghcr.io/replace-with-your-org/bma-backend@sha256:replace-with-published-digest
FRONTEND_IMAGE_REF=ghcr.io/replace-with-your-org/bma-frontend@sha256:replace-with-published-digest

DATABASE_URL=postgresql://bma_app:URL_ENCODED_PASSWORD@<DB_VM_PRIVATE_IP>:5432/bma_db

PUBLIC_API_URL=https://staging.example.com/api/v1
CORS_ORIGINS=https://staging.example.com
JWT_SECRET=replace-with-a-unique-staging-secret-at-least-32-characters
RESEND_API_KEY=

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

NODE_ENV=production
PORT=8081
UPLOAD_STORAGE_DIR=/app/uploads
UPLOAD_HOST_PATH=/opt/bma/uploads
MAX_UPLOAD_SIZE=26214400
TRUST_PROXY=true
EDGE_NETWORK_NAME=bma_edge
