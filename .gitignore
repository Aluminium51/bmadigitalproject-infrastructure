backups/
*.dump
*.backup
*.sql.gz
*.tar
*.tar.gz

# Private keys and certificates.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Local logs and OS metadata.
*.log
.DS_Store
Thumbs.db
